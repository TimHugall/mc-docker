# Example Terraform variables file
# Copy this to terraform.tfvars and update with your actual values

resource_group_name = "my-resource-group"
vm_name             = "my-minecraft-server"
nsg_name            = "my-nsg"

# Optional: customize allowed ports (defaults to SSH and Minecraft)
# allowed_ports = [22, 25565]

# Optional: customize starting priority for NSG rules (default is 100)
# rule_priority_start = 100
