# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your actual OCIDs

# OCID of your compartment (where resources are located)
compartment_id = "ocid1.compartment.oc1..aaaaaaaxxxxxx"

# OCID of your compute instance (to find the VCN/subnet)
instance_id = "ocid1.instance.oc1.region.aaaaaaaxxxxxx"
